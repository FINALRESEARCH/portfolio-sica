# =============================================================================
# SICA Portfolio — environment variables
# Copy into apps as noted below. Never commit real tokens.
# =============================================================================

# --- ui/.env.local -----------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=fdog0g13
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-07-31
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Viewer (or higher) token — server-only; do not prefix with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=

# --- cms/.env ----------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=fdog0g13
SANITY_STUDIO_DATASET=production

# --- Vercel (Project → Settings → Environment Variables) ---------------------
# Set the same NEXT_PUBLIC_* and SANITY_API_READ_TOKEN values for Production
# and Preview. Root Directory for the site project should be: ui
