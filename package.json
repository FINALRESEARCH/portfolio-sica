{
  "name": "sica-portfolio",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=ui --filter=cms",
    "dev:ui": "turbo run dev --filter=ui",
    "dev:cms": "turbo run dev --filter=cms",
    "build": "turbo run build",
    "build:ui": "turbo run build --filter=ui",
    "build:cms": "turbo run build --filter=cms",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "typegen": "pnpm --filter cms typegen",
    "scrape:webflow": "node scripts/scrape-webflow-live.mjs > scripts/webflow-inventory.json",
    "import:sanity": "node scripts/import-to-sanity.mjs"
  },
  "devDependencies": {
    "@sica/config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.10.7",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  }
}
